<Window x:Class="OrganizadorArquivosWPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login – Organizador de Arquivos"
        Width="400" Height="300"
        MinWidth="360" MinHeight="260"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#f4f7fa">

	<!-- ────────── Recursos (copiados da MainWindow) ────────── -->
	<Window.Resources>
		<!-- Cartão -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="13"/>
			<Setter Property="Padding"      Value="32,26"/>
            <Setter Property="Margin"       Value="22,14,22,12"/>
        </Style>

		<!-- Botões arredondados -->
		<ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
			<Border Background="{TemplateBinding Background}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
				<ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
			</Border>
		</ControlTemplate>

		<!-- PrimaryButton -->
		<Style x:Key="PrimaryButton" TargetType="Button">
			<Setter Property="Template"       Value="{StaticResource RoundedButtonTemplate}"/>
			<Setter Property="Background"     Value="#007ACC"/>
			<Setter Property="Foreground"     Value="White"/>
			<Setter Property="Padding"        Value="13,6"/>
			<Setter Property="FontWeight"     Value="SemiBold"/>
			<Setter Property="FontSize"       Value="15"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Margin"         Value="0,0,0,0"/>
			<Setter Property="Cursor"         Value="Hand"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#0585db"/>
					<Setter Property="Effect">
						<Setter.Value>
							<DropShadowEffect Color="#007acc" BlurRadius="13"
                                              ShadowDepth="1" Opacity="0.18"/>
						</Setter.Value>
					</Setter>
				</Trigger>
			</Style.Triggers>
		</Style>

		<!-- DangerButton -->
		<Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
			<Setter Property="Background" Value="#F34C4C"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#ff8383"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<!-- TextBox underline -->
		<Style x:Key="BottomBorderTextBox" TargetType="TextBox">
			<Setter Property="Background"      Value="Transparent"/>
			<Setter Property="BorderBrush"     Value="#007ACC"/>
			<Setter Property="BorderThickness" Value="0,0,0,2"/>
			<Setter Property="Padding"         Value="8,5,8,5"/>
			<Setter Property="Margin"          Value="0,0,0,13"/>
			<Setter Property="FontSize"        Value="17"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,0,7,7">
							<ScrollViewer x:Name="PART_ContentHost"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<!-- ────────── Layout de Login ────────── -->
	<Grid>
		<!-- Centraliza o cartão -->
		<Border Style="{StaticResource CardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="320">
			<StackPanel>

				<!-- Título -->
				<TextBlock Text="Bem-vindo!"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#34495e"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

				<!-- Matrícula -->
				<TextBlock Text="Digite sua matrícula:"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#34495e"
                           Margin="0,0,0,8"/>
				<TextBox x:Name="TxtMatricula"
                         Style="{StaticResource BottomBorderTextBox}"
                         Height="34"
                         MaxLength="20"
                         FontWeight="Normal"
                         KeyDown="TxtMatricula_KeyDown"/>

				<!-- Erro inline -->
				<TextBlock x:Name="LblErro"
                           Foreground="#F34C4C"
                           FontSize="13"
                           Margin="0,4,0,12"
                           Visibility="Collapsed"/>

				<!-- Botões -->
				<StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
					<Button Content="Cancelar"
                            Style="{StaticResource DangerButton}"
                            Width="100"
                            Margin="0,0,8,0"
                            Click="BtnCancelar_Click"/>
					<Button Content="Entrar"
                            Style="{StaticResource PrimaryButton}"
                            Width="100"
                            IsDefault="True"
                            Click="BtnEntrar_Click"/>
				</StackPanel>
			</StackPanel>
		</Border>
	</Grid>
</Window>

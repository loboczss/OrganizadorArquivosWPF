<Window x:Class="OrganizadorArquivosWPF.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SplashWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Width="400"
        Height="250"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">
    <Border CornerRadius="10" 
            Background="White" 
            BorderBrush="#888" 
            BorderThickness="1" 
            Padding="20"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Texto ou logo central -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10">
                <!-- Se tiver um logo, coloque aqui. Exemplo:
                <Image Source="/YourAssemblyName;component/Images/logo.png"
                       Width="120"
                       Height="120"
                       Stretch="Uniform" />
                -->
                <TextBlock Text="Organizador de Arquivos" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#333" 
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Texto de status -->
            <TextBlock Grid.Row="1" 
                       Text="Sincronizando dados, aguarde..." 
                       FontSize="14" 
                       Foreground="#555" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <!-- Barra de progresso indeterminada -->
            <ProgressBar Grid.Row="2"
                         IsIndeterminate="True"
                         Height="20"
                         Margin="0,0,0,10" />
        </Grid>
    </Border>
</Window>
